    {
      "parameters": {"workflowId": {"__rl": true, "value": "={{ $env.API_RETRY_WRAPPER_WORKFLOW_ID }}", "mode": "id"}, "workflowInputs": {"mappingMode": "defineBelow", "value": {"targetWorkflowId": "={{ $env.SUPABASE_MAIL_WORKFLOW_ID }}", "operation": "claim", "source": "={{ $json.source }}", "messageId": "={{ $json.messageId }}", "threadId": "={{ $json.threadId }}", "sender": "={{ $json.sender }}", "subject": "={{ $json.subject }}", "receivedAt": "={{ $json.receivedAt }}"}, "matchingColumns": [], "schema": []}, "options": {"waitForSubWorkflow": true}},
      "id": "execute-mail-claim",
