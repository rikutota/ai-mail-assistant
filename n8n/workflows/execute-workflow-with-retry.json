    "Should Retry?": {"main": [[{"node": "Wait Before Retry", "type": "main", "index": 0}], [{"node": "Store Final Error", "type": "main", "index": 0}]]},
    "Store Final Error": {"main": [[{"node": "Final Failure", "type": "main", "index": 0}]]},
    "Wait Before Retry": {"main": [[{"node": "Prepare Next Attempt", "type": "main", "index": 0}]]},
    "Prepare Next Attempt": {"main": [[{"node": "Execute Target Workflow", "type": "main", "index": 0}]]}
