{
  "name": "Common - Execute Workflow with Retry",
  "nodes": [
    {"parameters": {}, "id": "retry-wrapper-trigger", "name": "Execute Workflow Trigger", "type": "n8n-nodes-base.executeWorkflowTrigger", "typeVersion": 1.1, "position": [220, 300]},
    {
      "parameters": {"jsCode": "return $input.all().map((item) => {\n  if (typeof item.json.targetWorkflowId !== 'string' || !item.json.targetWorkflowId.trim()) throw new Error('targetWorkflowId is required');\n  return { json: { ...item.json, retryAttempt: Number(item.json.retryAttempt ?? 1) } };\n});"},
      "id": "initialize-retry", "name": "Initialize Retry", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [440, 300]
    },
    {
      "parameters": {"workflowId": {"__rl": true, "value": "={{ $json.targetWorkflowId }}", "mode": "id"}, "options": {"waitForSubWorkflow": true}},
      "id": "execute-target-workflow", "name": "Execute Target Workflow", "type": "n8n-nodes-base.executeWorkflow", "typeVersion": 1.2, "position": [660, 300], "onError": "continueErrorOutput"
    },
    {
      "parameters": {"workflowId": {"__rl": true, "value": "={{ $env.API_RETRY_POLICY_WORKFLOW_ID }}", "mode": "id"}, "options": {"waitForSubWorkflow": true}},
      "id": "classify-target-error", "name": "Classify Target Error", "type": "n8n-nodes-base.executeWorkflow", "typeVersion": 1.2, "position": [880, 420]
    },
    {
      "parameters": {"conditions": {"options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2}, "conditions": [{"id": "should-retry", "leftValue": "={{ $json.shouldRetry }}", "rightValue": true, "operator": {"type": "boolean", "operation": "true", "singleValue": true}}], "combinator": "and"}, "options": {}},
      "id": "should-retry-target", "name": "Should Retry?", "type": "n8n-nodes-base.if", "typeVersion": 2.2, "position": [1100, 420]
    },
    {
      "parameters": {"amount": "={{ $json.retryDelaySeconds }}", "unit": "seconds"},
      "id": "wait-before-retry", "name": "Wait Before Retry", "type": "n8n-nodes-base.wait", "typeVersion": 1.1, "position": [1320, 340], "webhookId": "d4695c58-ff38-41dd-aeff-04f6a357e092"
    },
    {
      "parameters": {"jsCode": "return $input.all().map((item) => ({ json: { ...item.json, retryAttempt: item.json.nextRetryAttempt } }));"},
      "id": "prepare-next-attempt", "name": "Prepare Next Attempt", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [1540, 340]
    },
    {
      "parameters": {"workflowId": {"__rl": true, "value": "={{ $env.ERROR_LOG_WORKFLOW_ID }}", "mode": "id"}, "workflowInputs": {"mappingMode": "defineBelow", "value": {"executionId": "={{ $execution.id }}", "stage": "={{ $json.stage }}", "source": "={{ $json.source }}", "messageId": "={{ $json.messageId }}", "mailLogId": "={{ $json.mailLogId }}", "errorCode": "={{ $json.statusCode ? `http_${$json.statusCode}` : 'external_api_error' }}", "summaryKey": "={{ $json.retryExhausted ? 'retry_exhausted' : ($json.statusCode === 401 ? 'authentication_failed' : ($json.statusCode === 403 ? 'permission_denied' : 'service_failed')) }}", "retryCount": "={{ Math.max(0, $json.retryAttempt - 1) }}"}, "matchingColumns": [], "schema": []}, "options": {"waitForSubWorkflow": true}},
      "id": "store-final-error", "name": "Store Final Error", "type": "n8n-nodes-base.executeWorkflow", "typeVersion": 1.2, "position": [1320, 500], "onError": "continueRegularOutput"
    },
    {
      "parameters": {"errorType": "errorObject", "errorObject": "={{ { name: 'ExternalApiError', message: `External API failed after ${$json.retryAttempt} attempt(s)`, statusCode: $json.statusCode, retryable: $json.retryable } }}"},
      "id": "fail-target-workflow", "name": "Final Failure", "type": "n8n-nodes-base.stopAndError", "typeVersion": 1, "position": [1540, 500]
    }
  ],
  "connections": {
    "Execute Workflow Trigger": {"main": [[{"node": "Initialize Retry", "type": "main", "index": 0}]]},
