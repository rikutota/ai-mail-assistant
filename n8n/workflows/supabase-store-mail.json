{
  "name": "Supabase - Claim and Finalize Mail Processing",
  "nodes": [
    {
      "parameters": {},
      "id": "store-mail-trigger",
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [220, 300]
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map((item) => {\n  const operation = item.json.operation ?? 'claim';\n  if (!['claim', 'finalize'].includes(operation)) throw new Error('operation must be claim or finalize');\n  if (operation === 'claim') {\n    if (!['gmail', 'outlook'].includes(item.json.source)) throw new Error('source must be gmail or outlook');\n    if (typeof item.json.messageId !== 'string' || !item.json.messageId.trim()) throw new Error('messageId is required');\n  } else if (typeof item.json.mailLogId !== 'string' || !/^[0-9a-f-]{36}$/i.test(item.json.mailLogId)) {\n    throw new Error('mailLogId is required for finalize');\n  }\n  return { json: { ...item.json, operation } };\n});"
      },
      "id": "validate-mail-operation",
      "name": "Validate Operation",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2},
          "conditions": [{"id": "is-finalize", "leftValue": "={{ $json.operation }}", "rightValue": "finalize", "operator": {"type": "string", "operation": "equals"}}],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "route-mail-operation",
      "name": "Is Finalize?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [660, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO mail_logs (source, message_id, thread_id, sender_email, subject, received_at, processed_status)\nVALUES ($1, $2, $3, $4, $5, $6, 'pending')\nON CONFLICT (source, message_id) DO NOTHING\nRETURNING id AS \"mailLogId\", source, message_id AS \"messageId\", true AS \"processingClaimed\";",
        "options": {"queryReplacement": "={{ [$json.source, $json.messageId, $json.threadId || null, $json.sender || null, $json.subject || null, $json.receivedAt || null] }}"}
      },
      "id": "claim-mail-processing",
      "name": "Claim Mail Processing",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [900, 400],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2},
          "conditions": [{"id": "claim-result", "leftValue": "={{ $json.processingClaimed }}", "rightValue": true, "operator": {"type": "boolean", "operation": "true", "singleValue": true}}],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "was-processing-claimed",
      "name": "Processing Claimed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1120, 400]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id AS \"mailLogId\", source, message_id AS \"messageId\", false AS \"processingClaimed\"\nFROM mail_logs\nWHERE source = $1 AND message_id = $2\nLIMIT 1;",
        "options": {"queryReplacement": "={{ [$('Validate Operation').item.json.source, $('Validate Operation').item.json.messageId] }}"}
      },
      "id": "load-existing-mail-log",
      "name": "Load Existing Mail Log",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [1340, 500]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE mail_logs\nSET summary = $2,\n    priority = $3,\n    category = $4,\n    requires_action = $5,\n    is_schedule = $6,\n    processed_status = 'processed',\n    processed_at = now(),\n    error_message = NULL\nWHERE id = $1 AND processed_status = 'pending'\nRETURNING id AS \"mailLogId\", source, message_id AS \"messageId\", processed_status AS \"processedStatus\";",
        "options": {"queryReplacement": "={{ [$json.mailLogId, $json.summary, $json.priority, $json.category, Boolean($json.requiresAction), Boolean($json.isSchedule)] }}"}
      },
      "id": "finalize-mail-processing",
      "name": "Finalize Mail Processing",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [900, 200]
    }
  ],
  "connections": {
    "Execute Workflow Trigger": {"main": [[{"node": "Validate Operation", "type": "main", "index": 0}]]},
    "Validate Operation": {"main": [[{"node": "Is Finalize?", "type": "main", "index": 0}]]},
    "Is Finalize?": {"main": [[{"node": "Finalize Mail Processing", "type": "main", "index": 0}], [{"node": "Claim Mail Processing", "type": "main", "index": 0}]]},
    "Claim Mail Processing": {"main": [[{"node": "Processing Claimed?", "type": "main", "index": 0}]]},
    "Processing Claimed?": {"main": [[], [{"node": "Load Existing Mail Log", "type": "main", "index": 0}]]}
  },
  "pinData": {},
  "settings": {"executionOrder": "v1", "saveDataErrorExecution": "none", "saveDataSuccessExecution": "none", "saveManualExecutions": false, "timezone": "Asia/Tokyo"},
  "active": false,
  "versionId": "03ac77f5-a55d-49b0-a647-04aa056b15bb",
  "meta": {"templateCredsSetupCompleted": false},
  "tags": []
}
